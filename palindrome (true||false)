#include <iostream>
using namespace std;
bool PAL(int x){
    int revnum=0;
    int n=x;
    int d=0;
    while(n>0){
        d=n%10;
        revnum=revnum*10+d;
        n=n/10;
        
    }
    if(x==revnum){
        return true;
    }
    else{
        return false;
    }
  
}
int main() {
   
    int x;
    cout<<"enter a number = ";
    cin>>x;
    cout<<PAL(x);
    return 0;
}


